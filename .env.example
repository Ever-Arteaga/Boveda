JWT_SECRETO=cambia-esto-por-un-string-largo-y-aleatorio
PORT=3000

# Sacá estos dos valores de Supabase: Project Settings > API
SUPABASE_URL=https://tuproyecto.supabase.co
# OJO: esta es la "service_role" key, NO la "anon public".
# La service_role tiene permisos totales y NUNCA se expone al navegador —
# solo la usa el servidor, por eso vive acá en el backend.
SUPABASE_SERVICE_ROLE_KEY=pegá-acá-la-service-role-key

# Nombre del bucket de Supabase Storage donde viven los archivos.
# Creálo desde el dashboard: Storage > New bucket > "boveda" > privado.
SUPABASE_BUCKET=boveda
